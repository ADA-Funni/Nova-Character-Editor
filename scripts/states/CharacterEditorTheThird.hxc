import flixel.FlxG;
import flixel.FlxCamera;

import Reflect;
import StringTools;

using StringTools;

class CharacterEditorV3 extends MusicBeatState {

    public static var startingChar = { text: "Boyfriend", id: "bf", protected: false };
    public static var skipPreloading:Bool = false;

    public var customCharacterRegistry = [
        "init" => "lol"
    ];

    public var editorTitle:String = "Nova Character Editor";
    public var editorVersion:String = "???";

    public var menuBar:MenuBar;
    public var bottomBar:MenuBar;

    public var iconPreview:HealthIcon;
    public var iconPreviewLosing:HealthIcon;

    public var iconWindow:Window;
    public var animationWindow:Window;
    public var editCharacterWindow:Window;

    public var camHUD:FlxCamera;
	public var camGame:FlxCamera;
    public var camBackground:FlxCamera;

    public var windowToggle:Bool = false;

    public var selectedCharacter;

    public var keybinds:Array = [];
    public var cancelInput:Bool = false;

    public var iconIDOverlay:FunkinSprite;

    function new() {
        super('CharacterEditorV3');
    }

    function create() {
        super.create();
        Cursor.show();

        for (i in PolymodHandler.getAllMods()) {
            if (i.title == editorTitle) {
                editorFolder = i.id;
                editorVersion = i.modVersion.version.join(".") + "-beta";
            } 
        }

        camBackground = new FlxCamera();
        camBackground.bgColor = 0xFF000000;
        FlxG.cameras.add(camBackground, false);

        camGame = new FlxCamera();
        camGame.bgColor = 0x00000000;
        FlxG.cameras.add(camGame, false);

        camHUD = new FlxCamera();
        camHUD.bgColor = 0x00000000;
        FlxG.cameras.add(camHUD, true);

        var bg = new FunkinSprite(0, 0).loadGraphic(Paths.image('menuDesat'));
		bg.scrollFactor.set(0, 0);
		bg.setGraphicSize(FlxG.width, FlxG.height);
		bg.updateHitbox();
		bg.screenCenter();
		bg.alpha = 0.5;
		bg.cameras = [camBackground];
		add(bg);

        menuBar = RuntimeComponentBuilder.build(Paths.ui("character-editor/menubar"));
        menuBar.findComponent("menuBarTitle").text = editorTitle + " v" + editorVersion;
        add(menuBar);

        menuBar.findComponent("uiSwap").onClick = ()->windowToggle = !windowToggle;
        
        var exitToMenuCallback = ()->{
            FlxG.switchState(new MainMenuState());
            PolymodHandler.forceReloadAssets();
        }

        menuBar.findComponent("exitToMenu").onClick = exitToMenuCallback;
        newKeybind(["CONTROL", "Q"], exitToMenuCallback);

        bottomBar = RuntimeComponentBuilder.build(Paths.ui("character-editor/bottombar"));
        add(bottomBar);
        bottomBar.y = FlxG.height - bottomBar.height;

        var style = RuntimeComponentBuilder.build(Paths.ui("character-editor/styles/main"));
        add(style);

        iconWindow = RuntimeComponentBuilder.build(Paths.ui("character-editor/windows/iconWindow"));
        add(iconWindow);
        iconWindow.screenCenter();
        
        iconPreview = new HealthIcon('bf');
        iconWindow.add(iconPreview);
        iconPreviewLosing = new HealthIcon('bf');
        iconWindow.add(iconPreviewLosing);

        iconWindow.findComponent("iconFlipX").onChange = ()->{
            selectedCharacter._data?.healthIcon?.flipX = iconWindow.findComponent("iconFlipX").selected;
            reloadIcons();
        }

        iconWindow.findComponent("iconIsPixel").onChange = ()->{
            selectedCharacter._data?.healthIcon?.isPixel = iconWindow.findComponent("iconIsPixel").selected;
            reloadIcons();
        }

        iconWindow.findComponent("iconScale").onChange = ()->{
            selectedCharacter._data?.healthIcon?.scale = iconWindow.findComponent("iconScale").pos;
            reloadIcons();
        }

        iconWindow.findComponent("iconOffsetX").onChange = ()->{
            selectedCharacter._data?.healthIcon?.offsets[0] = iconWindow.findComponent("iconOffsetX").pos;
            reloadIcons();
        }

        iconWindow.findComponent("iconOffsetY").onChange = ()->{
            selectedCharacter._data.healthIcon?.offsets[1] = iconWindow.findComponent("iconOffsetY").pos;
            reloadIcons();
        }

        iconWindow.findComponent("iconAssetPath").onChange = ()->{
            var targetID = iconWindow.findComponent("iconAssetPath").text;
            targetID = checkImageExists("icons/icon-" + targetID) ? targetID : "face";
            iconIDOverlay.visible = targetID == "face";
            selectedCharacter._data?.healthIcon?.id = targetID;
            reloadIcons();
        }

        iconIDOverlay = new FunkinSprite(105, 53).makeGraphic(iconWindow.findComponent("iconAssetPath").width - 2, iconWindow.findComponent("iconAssetPath").height - 2, FlxColor.RED);
        iconIDOverlay.blend = 0;
        iconIDOverlay.alpha = 0.5;
        iconWindow.add(iconIDOverlay);

        animationWindow = RuntimeComponentBuilder.build(Paths.ui("character-editor/windows/animationWindow"));
        add(animationWindow);
        animationWindow.screenCenter();

        editCharacterWindow = RuntimeComponentBuilder.build(Paths.ui("character-editor/windows/characterWindow"));
        add(editCharacterWindow);
        editCharacterWindow.screenCenter();

        reloadCharacterList();

        editCharacterWindow.findComponent("characterDropdown").onChange = ()->{
            if (members.contains(selectedCharacter))
                remove(selectedCharacter);

            selectedCharacter = CharacterDataParser.fetchCharacter("bf");
            trace(customCharacterRegistry.get(editCharacterWindow.findComponent("characterDropdown").selectedItem.id));
            selectedCharacter._data = customCharacterRegistry.get(editCharacterWindow.findComponent("characterDropdown").selectedItem.id);
            selectedCharacter.onCreate();
            selectedCharacter.cameras = [camGame];
            selectedCharacter.screenCenter();
            selectedCharacter.flipX = false;
            selectedCharacter.debug = true;
            add(selectedCharacter);

            editCharacterWindow.findComponent("charName").text = selectedCharacter._data.name;
            editCharacterWindow.findComponent("charName").onChange = ()->{
                selectedCharacter._data.name = editCharacterWindow.findComponent("charName").text;
                editCharacterWindow.findComponent("characterDropdown").selectedItem.text = editCharacterWindow.findComponent("charName").text;
                editCharacterWindow.findComponent("characterDropdown").text = editCharacterWindow.findComponent("charName").text;
            };
            editCharacterWindow.findComponent("charAssetPath").text = selectedCharacter._data.assetPath.replace("characters/", "");
            editCharacterWindow.findComponent("charScale").pos = selectedCharacter._data.scale;
            editCharacterWindow.findComponent("charSingTime").pos = selectedCharacter._data.singTime;
            editCharacterWindow.findComponent("charDanceInterval").pos = selectedCharacter._data.danceEvery;
            editCharacterWindow.findComponent("charOffsetsX").pos = (selectedCharacter._data?.offsets ?? [0, 0])[0];
            editCharacterWindow.findComponent("charOffsetsY").pos = (selectedCharacter._data?.offsets ?? [0, 0])[1];
            editCharacterWindow.findComponent("charCamOffsetsX").pos = (selectedCharacter._data?.cameraOffsets ?? [0, 0])[0];
            editCharacterWindow.findComponent("charCamOffsetsY").pos = (selectedCharacter._data?.cameraOffsets ?? [0, 0])[1];
            editCharacterWindow.findComponent("charFlipX").selected = selectedCharacter._data?.flipX ?? false;
            editCharacterWindow.findComponent("charIsPixel").selected = selectedCharacter._data?.isPixel ?? false;

            iconWindow.findComponent("iconAssetPath").text = selectedCharacter._data?.healthIcon?.id ?? selectedCharacter.id;
            iconWindow.findComponent("iconFlipX").selected = selectedCharacter._data?.healthIcon?.flipX ?? false;
            iconWindow.findComponent("iconIsPixel").selected = selectedCharacter._data?.healthIcon?.isPixel ?? false;
            iconWindow.findComponent("iconScale").pos = selectedCharacter._data?.healthIcon?.scale ?? 1;
            iconWindow.findComponent("iconOffsetX").pos = selectedCharacter._data?.healthIcon?.offsets[0] ?? 0;
            iconWindow.findComponent("iconOffsetY").pos = selectedCharacter._data?.healthIcon?.offsets[1] ?? 0;
            reloadAnimationList();
        }

        newKeybind(["W"], (elapsed) -> !cancelInput ? camGame.scroll.y -= ((FlxG.keys.pressed.SHIFT ? 10 : !FlxG.keys.pressed.CONTROL ? 5 : 0) * elapsed) * 75 : 0, "pressed");
        newKeybind(["A"], (elapsed) -> !cancelInput ? camGame.scroll.x -= ((FlxG.keys.pressed.SHIFT ? 10 : !FlxG.keys.pressed.CONTROL ? 5 : 0) * elapsed) * 75 : 0, "pressed");
        newKeybind(["S"], (elapsed) -> !cancelInput ? camGame.scroll.y += ((FlxG.keys.pressed.SHIFT ? 10 : !FlxG.keys.pressed.CONTROL ? 5 : 0) * elapsed) * 75 : 0, "pressed");
        newKeybind(["D"], (elapsed) -> !cancelInput ? camGame.scroll.x += ((FlxG.keys.pressed.SHIFT ? 10 : !FlxG.keys.pressed.CONTROL ? 5 : 0) * elapsed) * 75 : 0, "pressed");

        newKeybind(["Q"], (elapsed) -> (!cancelInput && !FlxG.keys.pressed.CONTROL) ? camGame.zoom -= (0.015 * elapsed) * 100 : 0, "pressed");
        newKeybind(["E"], (elapsed) -> (!cancelInput && !FlxG.keys.pressed.CONTROL) ? camGame.zoom += (0.015 * elapsed) * 100 : 0, "pressed");

        newKeybind(["CONTROL", "E"], ()->camHUD.visible = !camHUD.visible);

        var animationList = editCharacterWindow.findComponent("charAnimationList");
        animationList.onChange = ()->{
            selectedCharacter.playAnimation(animationList.selectedItem.text);
        }

        editCharacterWindow.findComponent("characterDropdown").selectedItem = startingChar;
    }

    function reloadCharacterList() {
        editCharacterWindow.findComponent("characterDropdown").dataSource.clear();
        var blackList = [];
        for (char in FileUtil.readDir("assets/data/characters")) {
            blackList.push(char.replace(".json", ""));
        }

        if (blackList.contains(startingChar.id))
            startingChar.protected = true;
        
        editCharacterWindow.findComponent("characterDropdown").dataSource.add(startingChar);
        customCharacterRegistry.set(startingChar.id, CharacterDataParser.fetchCharacter(startingChar.id)._data);

        var presets = [
            { text: "Boyfriend", id: "bf", protected: true },
            { text: "Girlfriend", id: "gf", protected: true },
            { text: "Daddy Dearest", id: "dad", protected: true },
            { text: "Senpai", id: "senpai", protected: true }
        ];
        for (i in presets) {
            if (i.id != startingChar.id) {
                editCharacterWindow.findComponent("characterDropdown").dataSource.add(i);
                customCharacterRegistry.set(i.id, CharacterDataParser.fetchCharacter(i.id)._data);
            }
        }
        for (i in CharacterDataParser.characterCache.keys()) {
            if (!blackList.contains(i)) {
                editCharacterWindow.findComponent("characterDropdown").dataSource.add({ text: CharacterDataParser.characterCache.get(i).name, id: i, protected: false });

                customCharacterRegistry.set(i, CharacterDataParser.fetchCharacter(i)._data);
            }
        }

        skipPreloading = false;
        Serialize.process(CharacterDataParser.fetchCharacter("bf")._data);
    }
 
    function reloadIcons() {
        iconPreview.configure(selectedCharacter._data?.healthIcon);
        iconPreview.playAnimation("idle", true);
        iconPreviewLosing.configure(selectedCharacter._data?.healthIcon);
        iconPreviewLosing.playAnimation("losing", true);
    }

    function reloadAnimationList() {
        var list = editCharacterWindow.findComponent("charAnimationList");
        list.dataSource.clear();
        for (i in selectedCharacter._data.animations) {
            list.dataSource.add({ text: i.name });
        }
        list.selectedItems = [];
        list.selectedItem = null;
    }

    function update(elapsed) {
        super.update(elapsed);        
        get_conductorInUse().update();

        if (FlxG.mouse.justPressed) {
            FlxG.sound.play(Paths.sound("click"));
        }

        if (editCharacterWindow != null) {
            var prev = editCharacterWindow.x;
            editCharacterWindow.x = MathUtil.coolLerp(editCharacterWindow.x, windowToggle ? 20 : FlxG.width - editCharacterWindow.width - 20, 0.1);
            iconWindow.x = MathUtil.coolLerp(iconWindow.x, windowToggle ? 20 + editCharacterWindow.width : FlxG.width - editCharacterWindow.width - 20 - iconWindow.width, 0.1);
            animationWindow.x = MathUtil.coolLerp(animationWindow.x, windowToggle ? 20 + editCharacterWindow.width : FlxG.width - editCharacterWindow.width - 20 - animationWindow.width, 0.1);
            animationWindow.y = editCharacterWindow.y;
            iconWindow.y = animationWindow.y + animationWindow.height;
            prev -= editCharacterWindow.x;
            camGame.x += prev*0.55;
        }

        if (FlxG.keys.justPressed.SPACE)
            selectedCharacter.playAnimation(selectedCharacter.animation.name, true);

        /* if (FlxG.keys.justPressed.D && FlxG.keys.pressed.CONTROL) windowToggle = false;
        if (FlxG.keys.justPressed.A && FlxG.keys.pressed.CONTROL) windowToggle = true; */

        for (keybind in keybinds) {
            var pressed = true;
            var index = 0;
            //trace(keybind);
            for (key in keybind.keys) {
                if (index == keybind.keys.length - 1 && keybind.type != "pressed") {
                    if (!Reflect.getProperty(FlxG.keys.justPressed, key)) {
                        pressed = false;
                    }
                } else {
                    if (!Reflect.getProperty(FlxG.keys.pressed, key)) {
                        pressed = false;
                    }
                }
                index++;
            }
            if (pressed) {
                keybind.action(elapsed);
            }
        }

        iconPreview.scale.set(0.7 * selectedCharacter._data?.healthIcon?.scale, 0.7 * selectedCharacter._data?.healthIcon?.scale);
        /* iconPreview.scale.x *= selectedCharacter._data?.healthIcon?.isPixel ? 5 : 1;
        iconPreview.scale.y *= selectedCharacter._data?.healthIcon?.isPixel ? 5 : 1; */
        iconPreview.updateHitbox();
        iconPreview.x = iconWindow.x + (iconWindow.width/2) - (iconPreview.width/2) - 50;
        iconPreview.y = iconWindow.y + (iconWindow.height/2) - (iconPreview.height/2) + 80;

        iconPreviewLosing.scale.set(0.7 * selectedCharacter._data?.healthIcon?.scale, 0.7 * selectedCharacter._data?.healthIcon?.scale);
        /* iconPreviewLosing.scale.x *= selectedCharacter._data?.healthIcon?.isPixel ? 5 : 1;
        iconPreviewLosing.scale.y *= selectedCharacter._data?.healthIcon?.isPixel ? 5 : 1; */
        iconPreviewLosing.updateHitbox();
        iconPreviewLosing.x = iconWindow.x + (iconWindow.width/2) - (iconPreviewLosing.width/2) + 50;
        iconPreviewLosing.y = iconWindow.y + (iconWindow.height/2) - (iconPreviewLosing.height/2) + 80;
    }

    function newKeybind(keys:Array<String>, action, ?type) {
        keybinds.push({
            keys: keys,
            type: type ?? "justPressed",
            action: action
        });
    }

    override function beatHit() {
        super.beatHit();
        var curBeat = get_conductorInUse().currentBeat;
    }
    override function stepHit() {
        super.stepHit();
        var curStep = get_conductorInUse().currentStep;
    }

    function destroy() {
        super.destroy();
        Cursor.hide();
    }

    function checkImageExists(id:String) {
        var fileExists = false;
        var foldersToCheck = [
            "assets/"
        ];

        for (mod in PolymodHandler.getAllMods()) {
            foldersToCheck.push("mods/" + mod.id + "/");
        }

        for (i in foldersToCheck) {
            if (FileUtil.fileExists(i + "images/" + id + ".png") || FileUtil.directoryExists(i + "images/" + id))
                fileExists = true;
            
            if (FileUtil.fileExists(i + "shared/images/" + id + ".png") || FileUtil.directoryExists(i + "images/" + id))
                fileExists = true;
        }

        return fileExists;
    }
}