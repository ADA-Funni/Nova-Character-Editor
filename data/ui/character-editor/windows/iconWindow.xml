<window title="Icon Info" width="260" height="40%" maximizable="false" minimizable="false" collapsable="false" closable="false">
    <grid width="100%">
        <label text="Asset Path:" style="padding: 2px;" verticalAlign="center" />
        <textfield id="iconAssetPath" placeholder="Icon Asset ID" width="100%" verticalAlign="center" tooltip="The Icons image name." />

        <label text="Scale:" style="padding: 2px;" verticalAlign="center" />
        <number-stepper id="iconScale" min="0.1" pos="1" step="0.1" width="100%" verticalAlign="center" tooltip="The Scale of the Icon."/>

        <label text="Offsets:" style="padding: 2px;" verticalAlign="center" />
        <hbox width="100%">
            <number-stepper id="iconOffsetX" min="0" pos="1" step="1" width="100%" verticalAlign="center" tooltip="The Animations X Offset."/>
            <number-stepper id="iconOffsetY" min="0" pos="1" step="1" width="100%" verticalAlign="center" tooltip="The Animations Y Offset."/>
        </hbox>
        
    </grid>

    <hbox width="100%" style="padding: 10px;">
        <spacer width="50%"/>
        <label text="Flip X:" style="padding: 2px;" verticalAlign="center"/>
        <checkbox id="iconFlipX" tooltip="Flip Icons X."/>
        <spacer width="10%"/>
        <label text="Pixel:" style="padding: 2px;" verticalAlign="center"  />
        <checkbox id="iconIsPixel" tooltip="Is your Icon Pixel?"/>
    </hbox>

</window>