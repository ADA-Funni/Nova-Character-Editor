<?xml version="1.0" encoding="utf-8" ?>
<dialog id="modDialog" width="600" height="400" title="Save Converted Character" closable="false">
	<vbox width="100%" height="100%">
		<label text="Choose Mod To Save Converted Character In:" style="padding: 2px;" verticalAlign="center"/>
		<dropdown id="modFolderList" text="None" width="100%" searchable="true">
            <data>
                <item text="None"/>
            </data>
        </dropdown>
	</vbox>
	<footer>
		<hbox>
			<button text="Cancel" id="dialogCancel"/>
			<spacer width="307" />
			<button text="Continue (Save Character)" id="dialogContinue"/>
		</hbox>
	</footer>
</dialog>
