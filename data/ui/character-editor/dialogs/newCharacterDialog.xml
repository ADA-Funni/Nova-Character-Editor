<?xml version="1.0" encoding="utf-8" ?>
<dialog id="modDialog" width="600" height="400" title="Create a New Character" closable="false">
	<vbox width="100%" height="100%">
		<label text="Choose Mod To Create Character In:" style="padding: 2px;" verticalAlign="center"/>
		<dropdown id="modFolderList" text="None" width="100%" searchable="true">
            <data>
                <item text="None"/>
            </data>
        </dropdown>

		<label text="Character Name:" style="padding: 2px;" verticalAlign="center"/>
        <textfield  id="characterNameField" placeholder="Character Name" width="100%" verticalAlign="center" validator="required" tooltip="Name of the character in-game."/>

		<label text="File Name:" style="padding: 2px;" verticalAlign="center"/>
        <textfield id="fileNameField" placeholder="File Name / Character ID" width="100%" verticalAlign="center" validator="required" tooltip="Name of the character file / The ID for the character."/>  

	</vbox>
	<footer>
		<hbox>
			<button text="Cancel" id="dialogCancel"/>
			<spacer width="307" />
			<button text="Continue (Create Character)" id="dialogContinue"/>
		</hbox>
	</footer>
</dialog>
